{
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "workspaces": [
    "packages/*",
    "play",
    "docs"
  ],
  "scripts": {
    "cz": "czg",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ssr": "vitest --config ./ssr-testing/vitest.config.ts",
    "prepare:e2e": "if [ ! -d \"docs/.vitepress/dist\" ]; then pnpm run docs:build; fi;",
    "dev": "pnpm -C play dev",
    "gen": "bash ./scripts/gc.sh",
    "gend": "bash ./scripts/gd.sh",
    "gen:version": "tsx scripts/gen-version.ts",
    "diff:table": "tsx scripts/build-table.ts",
    "update:version": "tsx scripts/update-version.ts",
    "clean": "pnpm run clean:dist && pnpm run -r --parallel clean",
    "clean:dist": "rimraf dist",
    "build": "pnpm run -C internal/build start",
    "build:theme": "pnpm run -C packages/theme-chalk build",
    "format": "prettier --write --cache .",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx,.md,.json --max-warnings 0 --cache",
    "lint:fix": "pnpm run lint --fix",
    "lint:commit": "commitlint --from $(git merge-base origin/dev HEAD) --to HEAD > ./commit-lint.txt",
    "typecheck": "run-p typecheck:web typecheck:play typecheck:node typecheck:vite-config typecheck:vitest",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --composite false --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:play": "vue-tsc -p tsconfig.play.json --composite false --noEmit",
    "typecheck:vite-config": "vue-tsc -p tsconfig.vite-config.json --composite false --noEmit",
    "typecheck:vitest": "vue-tsc -p tsconfig.vitest.json --composite false --noEmit",
    "docs:dev": "pnpm run -C docs dev",
    "docs:build": "pnpm run -C docs build",
    "docs:serve": "pnpm run -C docs serve",
    "docs:gen-locale": "pnpm run -C docs gen-locale",
    "docs:crowdin-credentials": "pnpm run -C docs crowdin-credentials",
    "stub": "pnpm run -r --parallel stub",
    "prepare": "husky install",
    "postinstall": "pnpm stub && concurrently \"pnpm gen:version\" \"pnpm run -C internal/metadata dev\"",
    "rm:nm": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@farst-three/components": "workspace:*",
    "@farst-three/constants": "workspace:*",
    "@farst-three/core": "0.0.3-alpha",
    "@farst-three/directives": "workspace:*",
    "@farst-three/hooks": "workspace:*",
    "@farst-three/locale": "workspace:*",
    "@farst-three/theme-chalk": "workspace:*",
    "@farst-three/utils": "workspace:*",
    "@floating-ui/dom": "^1.0.1",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.7",
    "@turf/turf": "^6.5.0",
    "@types/lodash": "^4.17.20",
    "@types/lodash-es": "^4.17.12",
    "@vueuse/core": "catalog:",
    "async-validator": "^4.2.5",
    "chroma-js": "^2.4.2",
    "d3-geo": "^3.1.0",
    "dat.gui": "^0.7.9",
    "dayjs": "^1.11.19",
    "escape-html": "^1.0.3",
    "gsap": "^3.12.2",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.3",
    "lygia": "^1.1.3",
    "memoize-one": "^6.0.0",
    "normalize-wheel-es": "^1.2.0",
    "puppeteer-core": "^24.35.0",
    "simplex-noise": "^4.0.1",
    "three": "0.158.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@esbuild-kit/cjs-loader": "^2.2.1",
    "@farst-three/build": "workspace:*",
    "@farst-three/build-utils": "workspace:*",
    "@farst-three/eslint-config": "workspace:*",
    "@pnpm/find-workspace-packages": "^4.0.16",
    "@pnpm/logger": "^4.0.0",
    "@pnpm/types": "^8.4.0",
    "@types/chroma-js": "^2.4.2",
    "@types/d3": "^7.4.2",
    "@types/dat.gui": "^0.7.10",
    "@types/fs-extra": "^9.0.13",
    "@types/gulp": "^4.0.9",
    "@types/jsdom": "^16.2.14",
    "@types/node": "^22.9.0",
    "@types/sass": "^1.43.1",
    "@types/three": "^0.158.2",
    "@vitejs/plugin-vue": "^2.3.3",
    "@vitejs/plugin-vue-jsx": "^1.3.10",
    "@vitest/ui": "^4.0.16",
    "@vue/server-renderer": "catalog:",
    "@vue/test-utils": "^2.0.0",
    "@vue/tsconfig": "^0.1.3",
    "c8": "^7.11.3",
    "chalk": "^5.0.1",
    "concurrently": "^7.2.2",
    "consola": "^2.15.3",
    "csstype": "^2.6.20",
    "cz-git": "^1.11.1",
    "czg": "^1.11.1",
    "eslint": "^9.37.0",
    "eslint-define-config": "^1.5.1",
    "expect-type": "^0.13.0",
    "fast-glob": "^3.2.11",
    "happy-dom": "^17.4.4",
    "husky": "^9.0.11",
    "jsdom": "16.4.0",
    "lint-staged": "^15.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^4.4.1",
    "sass": "^1.79.3",
    "tinyglobby": "^0.2.15",
    "ts-morph": "^14.0.0",
    "tsx": "^4.19.3",
    "type-fest": "^2.14.0",
    "typescript": "~5.5.4",
    "unplugin-element-plus": "^0.4.0",
    "unplugin-vue-macros": "0.11.2",
    "vite-plugin-glsl": "^1.1.2",
    "vite-plugin-glslify": "^2.0.2",
    "vitest": "^4.0.16",
    "vue": "catalog:",
    "vue-router": "^4.0.16",
    "vue-tsc": "=3.1.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vite",
        "react",
        "react-dom"
      ]
    }
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,md,json,scss}": [
      "eslint --fix --concurrency=auto",
      "prettier --write --experimental-cli"
    ]
  }
}
